---
import BaseLayout from './BaseLayout.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import {route,text,type Lang} from '../data/site';
const {lang,p}=Astro.props as {lang:Lang,p:any};
---
<BaseLayout lang={lang} path={`projects/${p.slug}`} title={`${p.title} | ${text(lang,'Youxing Kong','孔佑兴')}`} description={p.summary}>
<article class={`project-detail approved-project theme-${p.theme||'slate'}`}>
  <header class="page-heading project-heading">
    <a class="back-link" href={route(lang,'projects')}>← {text(lang,'All projects','全部项目')}</a>
    <p class="eyebrow">{p.subtitle}</p>
    <h1>{p.title}</h1>
  </header>
  <div class="project-body">
    <aside class="project-toc" aria-label={text(lang,'On this page','页内导航')}>
      <p class="eyebrow">{text(lang,'IN THIS PROJECT','本项目')}</p>
      {(p.approvedSections||[]).map((s:any)=><a href={`#${s.id}`}>{s.title}</a>)}
      {p.relatedPapers?.length>0&&<a href="#related-papers">{text(lang,'Related papers','相关论文与手稿')}</a>}
    </aside>
    <div class="project-prose reading">
      {(p.approvedSections||[]).map((s:any)=><section id={s.id} class="approved-section"><h2>{s.title}</h2>{s.blocks.map((b:any)=>b.type==='figure'?<ProjectMedia media={b.media} lang={lang}/>:<p class:list={{lead:b.intro}}>{b.text}</p>)}</section>)}
      {p.relatedPapers?.length>0&&<section class="approved-section related-project-papers" id="related-papers"><h2>{text(lang,'Related papers and manuscripts','相关论文与研究手稿')}</h2>{[
        {statuses:['published'],title:text(lang,'Published papers','已发表论文')},
        {statuses:['conference-paper'],title:text(lang,'Conference contributions','会议成果')},
        {statuses:['preprint'],title:text(lang,'Preprints','预印本')},
        {statuses:['under-review','manuscript-prepared'],title:text(lang,'Unpublished manuscripts','未发表手稿')}
      ].map(group=>{const papers=p.relatedPapers.filter((x:any)=>group.statuses.includes(x.status));return papers.length>0&&<div><h3>{group.title}</h3><ul>{papers.map((paper:any)=><li><span class="paper-status">{paper.statusLabel}{paper.year&&` · ${paper.year}`}</span><strong>{paper.url?<a href={paper.url} target="_blank" rel="noopener noreferrer">{paper.title} ↗</a>:paper.title}</strong><p class="authors">{paper.authors}</p>{paper.venue&&<p class="venue">{paper.venue}</p>}</li>)}</ul></div>})}</section>}
    </div>
  </div>
  <section class="section project-end"><a href={route(lang,'projects')}>← {text(lang,'Back to all projects','返回全部项目')}</a><a href={route(lang,'publications')}>{text(lang,'Publications','学术论文')} →</a></section>
<ImageLightbox lang={lang}/>
</article>
</BaseLayout>
