---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {route,asset,type Lang} from '../data/site';
const {lang='en',path='',title,description}=Astro.props as {lang:Lang,path?:string,title:string,description:string};
const canonical=new URL(path==='404'?asset('/404.html'):route(lang,path),Astro.site).href;
---
<!doctype html><html lang={lang==='zh'?'zh-CN':'en'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="en" href={new URL(route('en',path),Astro.site).href}/><link rel="alternate" hreflang="zh-CN" href={new URL(route('zh',path),Astro.site).href}/><link rel="alternate" hreflang="x-default" href={new URL(route('en',path),Astro.site).href}/><link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')}/><meta property="og:type" content="website"/><meta property="og:site_name" content="Youxing Kong"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={lang==='zh'?'zh_CN':'en_US'}/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="theme-color" content="#365e6b"/></head><body><a class="skip-link" href="#main">{lang==='zh'?'跳至主要内容':'Skip to content'}</a><Header lang={lang} path={path === '404' ? '' : path}/><main id="main" class="wrap"><slot/></main><Footer lang={lang}/></body></html>

