---
import {route,asset,type Lang} from '../data/site';
import ProjectCover from './ProjectCover.astro';
const {p,lang}=Astro.props as {p:any,lang:Lang};
---
<article class={`project-card theme-${p.theme||'slate'}`}><a class="project-thumb" href={route(lang,`projects/${p.slug}`)} tabindex="-1" aria-hidden="true"><ProjectCover p={p} lang={lang}/></a><p class="status">{p.status}</p><h2><a href={route(lang,`projects/${p.slug}`)}>{p.title}</a></h2><p>{p.question}</p><a class="text-link" href={route(lang,`projects/${p.slug}`)}>{lang==='zh'?'研究问题与方法':'Explore the research'} <span aria-hidden="true">→</span></a></article>
