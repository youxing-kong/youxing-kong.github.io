---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import SectionHeading from './SectionHeading.astro';
import ResearchSpine from './ResearchSpine.astro';
import ResearchApproach from './ResearchApproach.astro';
import ResearchProgramCard from './ResearchProgramCard.astro';
import ProjectCard from './ProjectCard.astro';
import PublicationItem from './PublicationItem.astro';
import RelatedResearchGroups from './RelatedResearchGroups.astro';
import SocialLinks from './SocialLinks.astro';
import CurriculumVitae from './CurriculumVitae.astro';
import en from '../content/en/home.json';
import zh from '../content/zh/home.json';
import publications from '../content/publications/publications.json';
import {profile} from '../data/profile';
import {route,asset,text,projectsFor,type Lang} from '../data/site';
const {lang='en',page='home'}=Astro.props as {lang:Lang,page?:string};
const c=lang==='zh'?zh:en;
const path=page==='home'?'':page;
const titles:any={research:text(lang,'Research','研究方向'),projects:text(lang,'Projects','研究项目'),publications:text(lang,'Publications','学术论文'),cv:text(lang,'Curriculum Vitae','个人简历')};
const descriptions:any={research:c.question,projects:text(lang,'Research projects in scientific AI, geohazards, geotechnical mechanics and engineering monitoring.','科学人工智能、地质灾害、岩土力学与工程监测研究项目。'),publications:text(lang,'Published papers and preprints by Youxing Kong.','孔佑兴的已发表论文与预印本。'),cv:text(lang,'Academic background, research experience, engineering practice and publications of Youxing Kong.','孔佑兴的教育、科研、工程实践及学术成果履历。')};
---
<BaseLayout lang={lang} path={path} title={page==='home'?c.title:`${titles[page]} | ${text(lang,'Youxing Kong','孔佑兴')}`} description={page==='home'?c.description:descriptions[page]}>
{page==='home'&&<><Hero lang={lang} c={c}/><section class="section"><SectionHeading number="01" title={text(lang,'Research','研究方向')} href={route(lang,'research')} linkLabel={text(lang,'Research overview','研究概览')}/><h2 class="question">{c.question}</h2><ResearchSpine c={c}/></section><section class="section"><SectionHeading number="02" title={text(lang,'Research Approach','研究方式')}/><ResearchApproach c={c}/></section><section class="section"><SectionHeading number="03" title={text(lang,'Selected Research','核心研究主线')}/>{c.programs.map(p=><ResearchProgramCard p={p} lang={lang}/>)}</section><section class="section"><SectionHeading number="04" title={text(lang,'Selected Publications','代表性论文')} href={route(lang,'publications')} linkLabel={text(lang,'All publications','全部论文')}/>{publications.filter(p=>p.selected).slice(0,5).map(p=><PublicationItem p={p} lang={lang}/>)}</section><section class="section about-section"><SectionHeading number="05" title={text(lang,'About','关于我')}/><div class="reading">{c.about.map(p=><p>{p}</p>)}<a href={route(lang,'cv')}>{text(lang,'Curriculum vitae','查看完整简历')} ↗</a></div></section><section class="section contact-section"><p class="eyebrow">{text(lang,'ACADEMIC CONVERSATIONS & COLLABORATIONS','学术交流与合作')}</p><h2>{text(lang,'Get in touch','欢迎联系')}</h2><p>{c.contact}</p><a class="email" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a><div class="inline-links"><SocialLinks/></div></section></>}
{page==='research'&&<><section class="page-heading"><p class="eyebrow">{text(lang,'RESEARCH','研究方向')}</p><h1>{text(lang,'Scientific AI for evolving geosystems','复杂地质系统演化的科学人工智能')}</h1><p class="lead">{c.summary}</p></section><section class="section"><SectionHeading number="01" title={text(lang,'The scientific question','核心科学问题')}/><h2 class="question">{c.question}</h2><ResearchSpine c={c}/></section><section class="section"><SectionHeading number="02" title={text(lang,'Three research programs','三条研究主线')}/>{c.programs.map(p=><ResearchProgramCard p={p} lang={lang} detail/>)}</section><section class="section"><SectionHeading number="03" title={text(lang,'Data + Physics + Knowledge','数据 + 物理 + 知识')}/><p class="reading lead">{c.integration}</p></section><section class="section"><SectionHeading number="04" title={text(lang,'Research Approach','研究方式')}/><ResearchApproach c={c}/></section><section class="section next-section"><h2>{text(lang,'From questions to projects','从研究问题到具体项目')}</h2><p>{text(lang,'Explore the data, methods, progress and outputs behind these research questions.','了解研究问题背后的数据、方法、阶段进展与成果。')}</p><a class="button" href={route(lang,'projects')}>{text(lang,'Explore projects','查看研究项目')} →</a></section></>}
{page==='projects'&&<><section class="page-heading projects-intro"><p class="eyebrow">{text(lang,'RESEARCH IN PRACTICE','具体研究工作')}</p><h1>{titles.projects}</h1><p class="lead">{text(lang,'From field observations to physical understanding and reliable prediction.','从真实观测出发，连接物理认识与可靠预测。')}</p><p class="projects-note">{text(lang,'Projects bring together published work, research manuscripts, and method demonstrations around shared scientific questions.','围绕共同的科学问题，组织已发表论文、研究手稿与方法展示。')}</p></section><div class="project-summary-strip"><span>{text(lang,'FIELD OBSERVATIONS','现场观测')}</span><span>{text(lang,'MULTISCALE MECHANICS','多尺度力学')}</span><span>{text(lang,'SPATIAL LEARNING','空间学习')}</span><span>{text(lang,'TRACEABLE EVIDENCE','可追溯证据')}</span></div><div class="projects-grid">{projectsFor(lang).map(p=><ProjectCard p={p} lang={lang}/>)}</div><RelatedResearchGroups lang={lang}/></>}
{page==='publications'&&<><section class="page-heading"><p class="eyebrow">{text(lang,'PAPERS & PREPRINTS','学术成果')}</p><h1>{titles.publications}</h1><p class="lead">{text(lang,'Research across geotechnical mechanics, scientific learning and engineering monitoring.','围绕岩土力学、科学学习与工程监测开展的研究。')}</p><div class="inline-links"><a href="#published">{text(lang,'Published','已发表')}</a><a href="#preprints">{text(lang,'Preprints','预印本')}</a></div></section><section class="section" id="published"><SectionHeading title={text(lang,'Published','已发表')} number="01"/>{publications.filter(p=>p.status==='published').sort((a,b)=>b.year-a.year).map(p=><PublicationItem p={p} lang={lang}/>)}</section><section class="section" id="conference-papers"><SectionHeading title={text(lang,'Conference contributions','会议成果')} number="02"/>{publications.filter(p=>p.status==='conference-paper').map(p=><PublicationItem p={p} lang={lang}/>)}</section><section class="section" id="preprints"><SectionHeading title={text(lang,'Preprints','预印本')} number="03"/>{publications.filter(p=>p.status==='preprint').map(p=><PublicationItem p={p} lang={lang}/>)}</section></>}
{page==='cv'&&<CurriculumVitae lang={lang}/>}
</BaseLayout>
