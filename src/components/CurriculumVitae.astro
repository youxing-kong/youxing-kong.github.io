---
import en from '../content/en/cv.json';
import zh from '../content/zh/cv.json';
import publications from '../content/publications/publications.json';
import PublicationItem from './PublicationItem.astro';
import {asset,text,type Lang} from '../data/site';
import {profile} from '../data/profile';
const {lang}=Astro.props as {lang:Lang};
const cv=lang==='zh'?zh:en;
const before=cv.sections.slice(0,4),after=cv.sections.slice(4);
const toc=[...before.map(s=>({id:s.id,title:s.title})),{id:'cv-publications',title:text(lang,'Publications','代表性论文')},...after.map(s=>({id:s.id,title:s.title}))];
---
<section class="page-heading cv-web-heading"><div><p class="eyebrow">{text(lang,'ACADEMIC BACKGROUND','学术履历')}</p><h1>{text(lang,'Curriculum Vitae','个人简历')}</h1><p class="cv-person">{cv.name}</p><p class="muted">{cv.role} · {cv.location}<br/><a href={`mailto:${cv.email}`}>{cv.email}</a></p></div><div class="cv-download"><a class="button" href={asset(profile.cv[lang])} download>{text(lang,'Download English CV','下载中文 CV')} <span aria-hidden="true">↓</span></a><p class="file-note">{text(lang,'PDF · English','PDF · 中文')}</p></div></section>
<div class="cv-layout"><nav class="cv-toc" aria-label={text(lang,'CV sections','简历章节')}>{toc.map(s=><a href={`#${s.id}`}>{s.title}</a>)}</nav><article class="cv-body"><section class="cv-overview"><h2>{cv.identity}</h2><p>{cv.summary}</p><p class="cv-research-line">{cv.spine}<br/>{cv.approach}</p></section>{before.map(s=><section class="cv-section" id={s.id}><h2>{s.title}</h2>{s.entries.map(e=><article class="cv-entry">{e.date&&<p class="cv-date">{e.date}</p>}<div><h3>{e.title}</h3>{e.paragraphs.map(p=><p>{p}</p>)}</div></article>)}</section>)}<section class="cv-section" id="cv-publications"><h2>{text(lang,'Publications','代表性论文')}</h2><h3 class="cv-pub-category">{text(lang,'Published','已发表')}</h3>{publications.filter(p=>p.status==='published').sort((a,b)=>b.year-a.year).map(p=><PublicationItem p={p} lang={lang}/>)}<h3 class="cv-pub-category">{text(lang,'Preprints','预印本')}</h3>{publications.filter(p=>p.status==='preprint').map(p=><PublicationItem p={p} lang={lang}/>)}</section>{after.map(s=><section class="cv-section" id={s.id}><h2>{s.title}</h2>{s.entries.map(e=><article class:list={['cv-entry',{'no-date':!e.date}]}>{e.date&&<p class="cv-date">{e.date}</p>}<div><h3>{e.title}</h3>{e.paragraphs.map(p=><p>{p}</p>)}</div></article>)}</section>)}</article></div>
