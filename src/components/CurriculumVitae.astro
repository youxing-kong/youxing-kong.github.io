---
import en from '../content/en/cv.json';
import zh from '../content/zh/cv.json';
import {asset,text,type Lang} from '../data/site';
import {profile} from '../data/profile';
const {lang}=Astro.props as {lang:Lang};
const cv:any=lang==='zh'?zh:en;
---
<section class="page-heading cv-web-heading"><div><p class="eyebrow">{text(lang,'ACADEMIC BACKGROUND','学术履历')}</p><h1>{text(lang,'Curriculum Vitae','个人简历')}</h1><p class="cv-person">{cv.name}</p><p class="muted">{cv.identity}<br/><a href={`mailto:${cv.email}`}>{cv.email}</a></p></div><div class="cv-download"><a class="button" href={asset(profile.cv[lang])} download>{text(lang,'Download English CV','下载中文 CV')} <span aria-hidden="true">↓</span></a><p class="file-note">{text(lang,'PDF · English','PDF · 中文')}</p></div></section>
<div class="cv-layout"><nav class="cv-toc" aria-label={text(lang,'CV sections','简历章节')}>{cv.sections.map((s:any)=><a href={`#${s.id}`}>{s.title}</a>)}</nav><article class="cv-body"><section class="cv-overview">{cv.overview.map((p:string)=><p>{p}</p>)}</section>{cv.sections.map((s:any)=><section class="cv-section" id={s.id}><h2>{s.title}</h2>{s.entries.map((e:any)=>e.kind==='subheading'?<h3 class="cv-pub-category">{e.title}</h3>:e.kind==='citation'?<p class="cv-citation">{e.rich.map((r:any)=>r.url?<a href={r.url} target="_blank" rel="noopener noreferrer">{r.text}</a>:r.text)}</p>:<article class:list={['cv-entry',{'no-date':!e.date}]}>{e.date&&<p class="cv-date">{e.date}</p>}<div>{e.title&&<h3>{e.title}</h3>}{e.paragraphs.map((p:string)=><p>{p}</p>)}</div></article>)}</section>)}</article></div>
