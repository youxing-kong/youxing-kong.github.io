---
import {route,type Lang} from '../data/site';
const {p,lang,detail=false}=Astro.props as {p:any,lang:Lang,detail?:boolean};
---
<article class="program" id={`program-${p.id}`}><div class="program-index">0{p.id}<span>{p.status}</span></div><div><h3>{p.title}</h3><p class="program-flow">{p.subtitle}</p><p>{p.summary}</p>{detail&&<p class="keywords">{p.keywords.join(' · ')}</p>}{p.id===1&&<p class="project-reference">{lang==='zh'?'代表项目':'Representative project'}: <a href={route(lang,'projects/stac-gnss')}>STAC-GNSS ↗</a></p>}<a class="text-link" href={detail?route(lang,'projects'):route(lang,'research')+`#program-${p.id}`}>{lang==='zh'?(detail?'查看研究项目':'了解研究方向'):(detail?'Explore projects':'View research')} <span aria-hidden="true">→</span></a></div></article>
