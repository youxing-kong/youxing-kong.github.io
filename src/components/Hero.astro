---
import {profile} from '../data/profile';
import {route,asset,type Lang} from '../data/site';
import SocialLinks from './SocialLinks.astro';
const {lang,c}=Astro.props as {lang:Lang,c:any};
---
<section class="hero"><div><p class="eyebrow">{lang==='zh'?'孔佑兴 · YOUXING KONG':'YOUXING KONG · 孔佑兴'}</p><h1>{c.heroLines.map((line:string,i:number)=><>{i>0&&<br/>}{line}</>)}<span class="period">.</span></h1><p class="hero-summary">{c.summary}</p><p class="muted hero-role">{c.role}<br/>{c.location}</p><div class="inline-links"><SocialLinks/><a href={route(lang,'cv')}>{lang==='zh'?'查看简历':'Curriculum vitae'} <span aria-hidden="true">↗</span></a><a href="mailto:kongyouxing@126.com">{lang==='zh'?'学术交流':'Get in touch'} <span aria-hidden="true">↗</span></a></div></div>{profile.portrait&&<img class="portrait" src={asset(profile.portrait)} width="240" height="300" alt={lang==='zh'?'孔佑兴个人照片':'Portrait of Youxing Kong'} fetchpriority="high"/>}</section>
